+    
+    // Step 7.5: Prepare Payments Body (if createPayment)
+    if (steps.includes('createPayment')) {
+        sequence.push({
+            name: 'preparePaymentsBody',
+            displayName: 'preparePaymentsBody',
+            isSpecial: true
+        });
