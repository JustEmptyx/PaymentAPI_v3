+    // Step 8: Create Payment
+    if (steps.includes('createPayment')) {
+        sequence.push({
+            name: 'createPayment',
+            displayName: `post${prefix}Payment`,
+            isSpecial: true,
+        });
+    }
+    
+    return sequence;
