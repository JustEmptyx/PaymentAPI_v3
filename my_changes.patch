+.result-status.success {
+    background-color: #ecfdf5;
+    color: #059669;
+}
+
+.result-status.error {
+    background-color: #fef2f2;
+    color: #dc2626;
+}
+
+.result-body {
+    padding: 15px;
+}
+
+.result-body pre {
+    margin: 0;
+    font-family: 'Fira Code', 'Consolas', monospace;
+    font-size: 0.875rem;
+    white-space: pre-wrap;
+    word-wrap: break-word;
+    max-height: 300px;
+    overflow-y: auto;
+}
+
+.result-headers {
+    padding: 8px 15px;
+    background-color: #f1f5f9;
+    border-top: 1px solid var(--border-color);
+    display: flex;
+    align-items: center;
+    gap: 10px;
+}
+
+.result-headers .header-label {
+    font-weight: 600;
+    color: var(--text-color);
+    font-size: 0.875rem;
+}
+
+.result-headers .header-value {
+    font-family: 'Fira Code', 'Consolas', monospace;
+    font-size: 0.8125rem;
+    color: var(--primary-color);
+    background-color: #eef2ff;
+    padding: 2px 8px;
+    border-radius: 4px;
+}
+
+/* Radio button styling */
+.radio-container input[type="radio"] {
+    width: 18px;
+    height: 18px;
+    accent-color: var(--primary-color);
+}
+
+.sequence-results::-webkit-scrollbar {
+    width: 8px;
+}
+
+.sequence-results::-webkit-scrollbar-track {
+    background: #f1f1f1;
+    border-radius: 4px;
+}
+
+.sequence-results::-webkit-scrollbar-thumb {
+    background: #c1c1c1;
+    border-radius: 4px;
+}
+
+/* Status Code Badge Styles */
+.result-meta {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+}
+
+.status-code {
+    display: inline-flex;
+    align-items: center;
+    padding: 4px 10px;
+    border-radius: 4px;
+    font-family: 'Fira Code', 'Consolas', monospace;
+    font-size: 0.8125rem;
+    font-weight: 600;
+    min-width: 50px;
+    justify-content: center;
+}
+
+/* Success codes (200-299) */
+.status-code-success {
+    background-color: #ecfdf5;
+    color: #059669;
+    border: 1px solid #a7f3d0;
+}
+
+/* Redirect codes (300-399) */
+.status-code-redirect {
+    background-color: #eff6ff;
+    color: #2563eb;
+    border: 1px solid #bfdbfe;
+}
+
+/* Client error codes (400-499) */
+.status-code-client-error {
+    background-color: #fffbeb;
+    color: #d97706;
+    border: 1px solid #fde68a;
+}
+
+/* Server error codes (500+) */
+.status-code-server-error {
+    background-color: #fef2f2;
+    color: #dc2626;
+    border: 1px solid #fecaca;
+}
+
+/* Info codes (other) */
+.status-code-info {
+    background-color: #f3f4f6;
+    color: #6b7280;
+    border: 1px solid #e5e7eb;
+}
